+    let Some(name_id) = lctx.names.iter().position(|n| n.eq_ignore_ascii_case(name)) else { return false; };
+    if let Some(slot) = handler.local_name_ids.iter().position(|&id| id as usize == name_id) {
+        player.scopes[idx].set_local(slot, crate::player::scope::StackDatum::Ref(value.clone()));
+        return true;
+    }
+    if let Some(slot) = handler.argument_name_ids.iter().position(|&id| id as usize == name_id) {
