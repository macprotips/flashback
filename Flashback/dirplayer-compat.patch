+/// Read-only animation diagnostics for one model. Mesh and motion arrays are
+/// summarized to keep captures bounded even for large game worlds.
+#[wasm_bindgen]
+pub fn mcp_inspect_3d_model(cast_lib: i32, cast_member: i32, model_name: String) -> String {
+    reserve_player_ref(|player| {
+        use serde_json::json;
+        let member_ref = CastMemberRef { cast_lib, cast_member };
+        let Some(w3d) = player.movie.cast_manager.find_member_by_ref(&member_ref)
+            .and_then(|member| member.member_type.as_shockwave3d()) else {
+            return json!({"error":"Not a Shockwave3D member"}).to_string();
+        };
+        let Some(scene) = &w3d.parsed_scene else {
+            return json!({"error":"Scene not loaded"}).to_string();
+        };
+        let name = Symbol::from_str(&model_name);
+        let Some(node) = scene.nodes.iter().find(|node| node.name == name) else {
+            return json!({"error":"Model not found"}).to_string();
+        };
+        let resource = if node.model_resource_name.is_empty() { node.resource_name } else { node.model_resource_name };
+        let skeleton = scene.skeletons.iter().find(|skeleton| skeleton.name == resource);
+        let bp = w3d.runtime_state.bones_player(name);
+        let motion = bp.and_then(|bp| bp.current_motion)
+            .and_then(|name| scene.motions.iter().find(|motion| motion.name == name));
+        let runtime_transform = w3d.runtime_state.node_transforms.get(&name).copied();
+        let mesh_bounds = scene.clod_meshes.get(&resource).and_then(|meshes| {
+            let mut min = [f32::INFINITY; 3];
+            let mut max = [f32::NEG_INFINITY; 3];
+            let mut count = 0usize;
+            for position in meshes.iter().flat_map(|mesh| mesh.positions.iter()) {
+                for axis in 0..3 {
+                    min[axis] = min[axis].min(position[axis]);
+                    max[axis] = max[axis].max(position[axis]);
+                }
+                count += 1;
+            }
+            (count > 0).then_some(json!({"min":min,"max":max,"vertices":count}))
+        });
+        json!({
+            "model":node.name.as_str(), "resource":resource.as_str(),
+            "parent":node.parent_name.as_str(),
+            "parsed_transform":node.transform,
+            "runtime_transform":runtime_transform,
+            "mesh_bounds":mesh_bounds,
+            "skeletons":scene.skeletons.iter().take(128).map(|s| json!({"name":s.name.as_str(),"bones":s.bones.len()})).collect::<Vec<_>>(),
+            "bones":skeleton.map(|s| s.bones.iter().take(128).map(|b| json!({"name":b.name.as_str(),"parent":b.parent_index})).collect::<Vec<_>>()),
+            "motion":motion.map(|m| json!({"name":m.name.as_str(),"duration":m.duration(),"tracks":m.tracks.iter().take(128).map(|t| json!({"name":t.bone_name.as_str(),"keys":t.keyframes.len(),"first":t.keyframes.first().map(|k| k.time),"last":t.keyframes.last().map(|k| k.time)})).collect::<Vec<_>>() })),
+            "player":bp.map(|bp| json!({"time":bp.animation_time,"playing":bp.animation_playing,"ended":bp.motion_ended,"queue":bp.motion_queue.iter().take(32).map(|q| q.name.as_str()).collect::<Vec<_>>()})),
+            "meshes":scene.clod_meshes.get(&resource).map(|meshes| meshes.iter().take(32).map(|mesh| json!({"vertices":mesh.positions.len(),"weighted_vertices":mesh.bone_weights.len(),"indexed_vertices":mesh.bone_indices.len(),"first_indices":mesh.bone_indices.iter().take(4).collect::<Vec<_>>(),"first_weights":mesh.bone_weights.iter().take(4).collect::<Vec<_>>() })).collect::<Vec<_>>()),
+        }).to_string()
+    })
+}
