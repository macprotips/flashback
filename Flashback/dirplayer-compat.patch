 /// The player uses global mutable statics, so tests must be serialized.
 static TEST_LOCK: Mutex<()> = Mutex::new(());
 
+/// Take the same lock for a test that touches global VM state but does not
+/// need a whole player — interning a symbol writes to `static mut
+/// SYMBOL_TABLE`, so doing it off-lock races any test that holds the lock.
+/// That race made `object_identity_tests` fail only when the suite's thread
+/// scheduling happened to overlap them, which is worse than a steady failure.
+pub fn lock_global_state() -> std::sync::MutexGuard<'static, ()> {
+    TEST_LOCK.lock().unwrap_or_else(|e| e.into_inner())
+}
