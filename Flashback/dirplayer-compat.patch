+/// Convert Director/IFX texture blend functions to the fragment shader's
+/// extra-layer encoding. The authored blend function is authoritative: a
+/// texture named "lightmap" may be either additive lighting or a multiplicative
+/// baked shadow map, and guessing from its name washes out the latter.
+fn extra_layer_blend_mode(blend_func: u8) -> i32 {
+    match blend_func {
+        0 => 3, // IFX_SELECT_ARG0 / #replace
+        1 => 2, // IFX_ADD / #add
+        2 => 1, // IFX_MODULATE / #multiply
+        3 => 4, // IFX_INTERPOLATE / #blend
+        _ => 1, // other modulate variants are closest to #multiply
+    }
+}
