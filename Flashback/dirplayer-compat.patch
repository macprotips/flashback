+/// ("Roll"). A single bad span raises the movie's `frame_count` to ~1.8
+/// billion, so `get_next_frame` never loops the playhead back to frame 1 and it
+/// runs on into empty frames — a stalled, black stage rather than a visible
+/// error. The 52+ branch keeps its own tighter start_frame bound.
+fn primary_header_plausible(entry: &[u8]) -> bool {
+    if entry.len() < 20 {
