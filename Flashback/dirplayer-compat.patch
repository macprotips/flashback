+/// A single-track keyframePlayer motion is a local transform applied after the
+/// model's authored or scripted placement: base * motion.
+fn compose_object_keyframe_transform(
+    base_placement: [f32; 16],
+    keyframe: &[f32; 16],
+) -> [f32; 16] {
+    mat4_multiply_col_major(&base_placement, keyframe)
+}
