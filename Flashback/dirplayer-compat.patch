+    let end_frame = u32::from_be_bytes([entry[4], entry[5], entry[6], entry[7]]);
+    let channel_index = u32::from_be_bytes([entry[16], entry[17], entry[18], entry[19]]);
+    start_frame >= 1 && end_frame >= start_frame && end_frame <= 100000 && channel_index < 512
