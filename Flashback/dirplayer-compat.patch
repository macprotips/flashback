+#[cfg(all(test, not(target_arch = "wasm32")))]
+mod object_identity_tests {
+    use super::*;
+    use crate::player::{
+        cast_lib::CastMemberRef, handlers::types::TypeUtils,
+        reserve_player_mut, reserve_player_ref, script::ScriptInstance,
+        symbols::{builtin::BuiltInSymbol, symbol::Symbol, symbol_table::init_symbol_table},
+        testing::{run_test, TestPlayer},
+    };
+
+    #[test]
+    fn object_strings_keep_unique_ids_when_references_change() {
+        init_symbol_table();
+        run_test(async {
+            let _player = TestPlayer::new();
+            let (first, second) = reserve_player_mut(|player| {
+                let mut make = || {
+                    let instance = ScriptInstance {
+                        instance_id: player.allocator.get_free_script_instance_id(),
+                        script: CastMemberRef { cast_lib: 1, cast_member: 99 },
+                        ancestor: None, properties: Default::default(), begin_sprite_called: false,
+                    };
+                    Datum::ScriptInstanceRef(player.allocator.alloc_script_instance(instance))
+                };
+                (make(), make())
+            });
+            let before = reserve_player_ref(|player| format_concrete_datum(&first, player));
+            let copy = first.clone();
+            let (after, other) = reserve_player_ref(|player| (
+                format_concrete_datum(&copy, player), format_concrete_datum(&second, player)
+            ));
+            // These are the fields parsed by legacy object registries.
+            assert_eq!(before.split('"').nth(1), Some("(stale)"));
+            assert_eq!(before.split_whitespace().last(), after.split_whitespace().last());
+            assert_ne!(before.split_whitespace().last(), other.split_whitespace().last());
+            assert_ne!(before, after); // The reference count changed, the ID did not.
+            assert_eq!(TypeUtils::get_datum_ilk(&first).unwrap(), BuiltInSymbol::Instance);
+            assert!(TypeUtils::is_datum_ilk(&first, Symbol::from_str("object")).unwrap());
+        });
+    }
+
+    #[test]
+    fn object_alias_preserves_primary_types_and_rejects_values() {
+        let _global = crate::player::testing::lock_global_state();
+        init_symbol_table();
+        for (datum, primary) in [(Datum::SpriteRef(1), BuiltInSymbol::Sprite),
+            (Datum::CastLib(1), BuiltInSymbol::CastLib),
+            (Datum::CastMember(CastMemberRef { cast_lib: 1, cast_member: 1 }), BuiltInSymbol::Member)] {
+            let kinds = TypeUtils::get_datum_ilks(&datum).unwrap();
+            assert_eq!(kinds[0], primary);
+            assert!(TypeUtils::is_datum_ilk(&datum, Symbol::from_str("object")).unwrap());
+        }
+        for datum in [Datum::Void, Datum::Int(1), Datum::String("object".into()),
+            Datum::CastMember(CastMemberRef { cast_lib: -1, cast_member: -1 })] {
+            assert!(!TypeUtils::is_datum_ilk(&datum, Symbol::from_str("object")).unwrap());
+        }
+    }
 }
