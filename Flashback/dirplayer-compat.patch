diff -ruN -x node_modules -x target -x pkg -x dist -x dist-polyfill -x dist-extension -x .DS_Store -x npm-build.log -x test-results -x playwright-report a/vm-rust/examples/inspect_scripts.rs b/vm-rust/examples/inspect_scripts.rs
--- a/vm-rust/examples/inspect_scripts.rs
+++ b/vm-rust/examples/inspect_scripts.rs
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Read-only script inventory and decompilation, without starting the player.
+use serde_json::json;
+use vm_rust::director::{file::{read_director_file_bytes, get_variable_multiplier}, lingo::decompiler::decompile_handler};
+
+fn main() {
+    let path = std::env::args().nth(1).expect("usage: inspect_scripts MOVIE");
+    let bytes = std::fs::read(&path).expect("read movie");
+    let file = read_director_file_bytes(&bytes, &path, "file:///").expect("parse movie");
+    let mut scripts = Vec::new();
+    for cast in &file.casts {
+        let Some(ctx) = &cast.lctx else { continue };
+        let mut chunks: Vec<_> = ctx.scripts.iter().collect();
+        chunks.sort_by_key(|(id, _)| **id);
+        for (id, chunk) in chunks {
+            let member = cast.members.iter().find(|(_, m)| m.chunk.member_info.as_ref().is_some_and(|i| i.header.script_id == *id));
+            for handler in &chunk.handlers {
+                let result = decompile_handler(handler, chunk, ctx, cast.dir_version, get_variable_multiplier(cast.capital_x, cast.dir_version));
+                scripts.push(json!({"cast": cast.id, "cast_name": cast.name, "script_id": id,
+                    "member": member.map(|(n,_)| n), "script": member.and_then(|(_,m)| m.chunk.member_info.as_ref().map(|i| &i.name)),
+                    "handler": result.name, "arguments": result.arguments,
+                    "source": result.lines.iter().map(|l| format!("{}{}", "  ".repeat(l.indent as usize), l.text)).collect::<Vec<_>>().join("\n")}));
+            }
+        }
+    }
+    println!("{}", serde_json::to_string_pretty(&json!({"file":path,"scripts":scripts})).unwrap());
+}
