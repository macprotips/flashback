vcpkg_from_sourceforge(OUT_SOURCE_PATH SOURCE_PATH
    REPO mikmod/libmikmod REF 3.3.11.1 FILENAME "libmikmod-3.3.11.1.tar.gz"
    SHA512 f2439e2b691613847cd0787dd4e050116683ce7b05c215b8afecde5c6add819ea6c18e678e258c0a80786bef463f406072de15127f64368f694287a5e8e1a9de)
vcpkg_cmake_configure(SOURCE_PATH "${SOURCE_PATH}"
    OPTIONS -DENABLE_STATIC=ON -DENABLE_DOC=OFF -DENABLE_THREADS=ON
    -DDISABLE_HQMIXER=OFF -DENABLE_OPENAL=OFF -DENABLE_SIMD=ON)
vcpkg_cmake_install()
vcpkg_fixup_pkgconfig()
file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/debug/include" "${CURRENT_PACKAGES_DIR}/share/man" "${CURRENT_PACKAGES_DIR}/bin")
vcpkg_install_copyright(FILE_LIST "${SOURCE_PATH}/COPYING.LESSER" "${SOURCE_PATH}/COPYING.LIB")
